<section class="about-prose">
    <div class="about-prose__inner reveal">
      <h2 class="about-prose__heading">{{ section.settings.heading }}</h2>
      {{ section.settings.body }}
    </div>
  </section>

{% schema %}
{
  "name": "About Artisans",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Artisans"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p class=\"about-prose__text\">The <em>kaarigars<\/em> we work with are fifth and sixth generation masters of techniques that are both endangered and irreplaceable. We collaborate closely with small artisan clusters, building relationships based on respect — until the craft feels honored, wearable, and effortless on the body.<\/p>"
    }
  ]
}
{% endschema %}
