<section class="hero" id="hero">
    <div class="hero__video-wrap">
      <video class="hero__video" autoplay muted loop playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
      <div class="hero__gradient"></div>
    </div>
    <div class="hero__content">
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">{{ section.settings.title }}</h1>
      <a href="{{ section.settings.cta_link }}" class="hero__cta">{{ section.settings.cta_text }}</a>
    </div>
    <div class="hero__scroll-indicator" id="scrollIndicator">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </section>

{% schema %}
{
  "name": "Hero Video",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://cdn.shopify.com/videos/c/o/v/16877ef80d6a48219c5791bac0ab1b86.mp4"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Designed in New England · Handcrafted in India"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "Where Heritage<br>Meets Contemporary Craft"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link",
      "default": "/collections"
    }
  ],
  "presets": [
    {
      "name": "Hero Video"
    }
  ]
}
{% endschema %}
