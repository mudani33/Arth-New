<section class="newsletter reveal">
    <div class="newsletter__inner">
      <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
      <p class="newsletter__text">{{ section.settings.text }}</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__form">
          <input type="email" name="contact[email]" class="newsletter__input" placeholder="{{ section.settings.placeholder }}" required style="border-radius:9999px;-webkit-border-radius:9999px;">
          <button type="submit" class="newsletter__submit">{{ section.settings.submit_text }}</button>
        </div>
      {% endform %}
    </div>
  </section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Atelier"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Be the first to know about new collections, artisan stories, and exclusive access."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit Button Text",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
