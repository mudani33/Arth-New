{%- liquid
  assign is_homepage = false
  if template.name == 'index'
    assign is_homepage = true
  endif

  assign is_shop_page = false
  if template.name == 'collection'
    assign is_shop_page = true
  endif

  assign nav_class = 'nav'
  unless is_homepage or is_shop_page
    assign nav_class = 'nav nav--solid'
  endunless
-%}

<nav class="{{ nav_class }}" id="nav">
  <div class="nav__inner">
    <a href="{{ routes.root_url }}" class="nav__logo">
      <img src="{{ section.settings.logo | default: 'https://cdn.shopify.com/s/files/1/0581/8882/4670/files/Secondary_Logo_Caviar_3x_499f4767-b112-4d43-aaef-79a61bddb119.png?v=1745254263' }}" alt="{{ shop.name }}" class="nav__logo-img" style="height:14px;max-height:14px;width:auto;">
    </a>
    <ul class="nav__links">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}"{% if link.active %} class="nav__link--active"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="nav__actions">
      <a href="{{ routes.search_url }}" class="nav__search" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="nav__cart" aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="nav__cart-count{% if cart.item_count > 0 %} nav__cart-count--visible{% endif %}">{{ cart.item_count }}</span>
      </a>
      <button class="nav__menu-toggle" aria-label="Menu" id="menuToggle">
        <span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div class="mobile-menu" id="mobileMenu">
  <ul class="mobile-menu__links">
    {%- for link in section.settings.menu.links -%}
      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    }
  ]
}
{% endschema %}
