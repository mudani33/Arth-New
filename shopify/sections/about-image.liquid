<section class="about-image reveal">
    <div class="about-image__inner">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.alt }}" loading="lazy">
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/0581/8882/4670/files/Banner_1000_x_1100_px_1.png?v=1761425058" alt="{{ section.settings.alt }}" loading="lazy">
      {%- endif -%}
    </div>
  </section>

{% schema %}
{
  "name": "About Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt Text",
      "default": "Arth Atelier"
    }
  ]
}
{% endschema %}
