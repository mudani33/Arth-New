<section class="pillars">
    <div class="pillars__inner">
      {%- for block in section.blocks -%}
      <div class="pillar reveal" {{ block.shopify_attributes }}>
        <span class="pillar__icon">{{ block.settings.icon_svg }}</span>
        <h3 class="pillar__title">{{ block.settings.title }}</h3>
        <p class="pillar__text">{{ block.settings.text }}</p>
      </div>
      {%- endfor -%}
    </div>
  </section>

{% schema %}
{
  "name": "Three Pillars",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pillar"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Description text here."
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "The Art",
            "text": "Contemporary silhouettes that honor the dialogue between East and West — minimal, considered, timeless.",
            "icon_svg": "<svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 4l4 4-12 12H8v-4L20 4z\"/><path d=\"M4 24h20\"/></svg>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "The Craft",
            "text": "Centuries-old techniques — Aari embroidery, Chikankari, hand-weaving — performed by multi-generational artisan families.",
            "icon_svg": "<svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 4c-2 4-6 6-6 10a6 6 0 0012 0c0-4-4-6-6-10z\"/><path d=\"M10 18l4-4 4 4\"/></svg>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "The Impact",
            "text": "A traceable, sustainable supply chain that puts artisan welfare and environmental responsibility first.",
            "icon_svg": "<svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 24V12\"/><path d=\"M14 12c3-3 8-4 10-1s-3 7-10 13\"/><path d=\"M14 12c-3-3-8-4-10-1s3 7 10 13\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
