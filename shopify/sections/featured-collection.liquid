<section class="collection" id="collection">
    <div class="collection__header reveal">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="collection__grid">
      {%- for product in collections[section.settings.collection].products limit: section.settings.products_to_show -%}
      <article class="product-card reveal" data-product="{{ product.id }}">
        <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
        <div class="product-card__image-wrap">
          <div class="product-card__image">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
          </div>
          <div class="product-card__quick-add">
            <span class="product-card__quick-add-label">Quick Add</span>
            <div class="product-card__sizes">
              {%- for variant in product.variants -%}
                <button class="size-btn" data-variant-id="{{ variant.id }}">{{ variant.title }}</button>
              {%- endfor -%}
            </div>
          </div>
        </div>
        <div class="product-card__info">
          <h3 class="product-card__name">{{ product.title }}</h3>
          <p class="product-card__price">{{ product.price | money }}</p>
        </div>
        </a>
      </article>
      {%- endfor -%}
    </div>
    <div class="collection__cta reveal">
      <a href="{{ collections[section.settings.collection].url }}" class="btn btn--outline">{{ section.settings.cta_text }}</a>
    </div>
  </section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pieces That Carry Meaning"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each garment is a dialogue between centuries-old craft and contemporary design \u2014 hand-finished by artisans whose families have practiced these techniques for generations."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "View All Pieces"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
