<section class="editorial" id="sustainability">
    <div class="editorial__inner editorial__inner--image-{{ section.settings.image_position }}">
      {%- if section.settings.image_position == 'left' -%}
      <div class="editorial__image reveal reveal--slide-right">
        <div class="editorial__image-frame">
          <img src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 }}{%- else -%}{{ section.settings.image_url }}{%- endif -%}" alt="{{ section.settings.image_alt }}" loading="lazy" class="editorial__img">
        </div>
      </div>
      <div class="editorial__text reveal reveal--slide-left">
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="editorial__title">{{ section.settings.heading }}</h2>
        <p class="editorial__body">{{ section.settings.body_1 }}</p>
        <p class="editorial__body">{{ section.settings.body_2 }}</p>
        <a href="{{ section.settings.link_url }}" class="btn btn--text">{{ section.settings.link_text }}</a>
      </div>
      {%- else -%}
      <div class="editorial__text reveal reveal--slide-right">
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="editorial__title">{{ section.settings.heading }}</h2>
        <p class="editorial__body">{{ section.settings.body_1 }}</p>
        <p class="editorial__body">{{ section.settings.body_2 }}</p>
        <a href="{{ section.settings.link_url }}" class="btn btn--text">{{ section.settings.link_text }}</a>
      </div>
      <div class="editorial__image reveal reveal--slide-left">
        <div class="editorial__image-frame">
          <img src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 }}{%- else -%}{{ section.settings.image_url }}{%- endif -%}" alt="{{ section.settings.image_alt }}" loading="lazy" class="editorial__img">
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>

{% schema %}
{
  "name": "Editorial — Traceability",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0581/8882/4670/files/Supply_Chain_1.png?v=1772413828"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Arth Atelier supply chain traceability"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Traceability"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (HTML allowed for line breaks)",
      "default": "From Farm to Fiber<br>to Your Wardrobe"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body Paragraph 1",
      "default": "Every Arth Atelier garment comes with a QR code that traces its journey — from the farm where the fiber was harvested, to the spinning, weaving, dyeing, and hand-finishing. Complete transparency, no exceptions."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body Paragraph 2",
      "default": "We work exclusively with natural, organic, and recycled materials: traceable organic wool, peace silk, Lyocell, and upcycled deadstock fabrics. Our supply chain is short, sustainable, and intentional."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Discover Our Process →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "default": "/pages/traceability"
    }
  ],
  "presets": [
    {
      "name": "Editorial — Traceability"
    }
  ]
}
{% endschema %}
